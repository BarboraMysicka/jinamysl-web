---
import Base from '../layouts/Base.astro';
import HlavickaPodstranka from '../components/HlavickaPodstranka.astro';
import Paticka from '../components/Paticka.astro';
---
<Base title="Stránka nenalezena — Jiná mysl, z. s." popis="Tuhle stránku se nám nepodařilo najít." zamkniZvenci={true}>
  <HlavickaPodstranka />
  <main id="obsah" class="podstranka">
    <section class="ctyri04">
      <div class="wrap">
        <span class="d-stitek">404</span>
        <h1 class="ctyri04-h1">Tady jsme se ztratili.</h1>
        <p class="ctyri04-text">Tuhle stránku se nám nepodařilo najít — možná byla přejmenovaná nebo už neexistuje. Zkuste to prosím jinudy:</p>
        <div class="ctyri04-odkazy">
          <a class="btn btn-plny" href="/">Zpět na úvod <span class="sipka">→</span></a>
          <nav class="ctyri04-nav">
            <a href="/#projekty">Projekty</a>
            <a href="/o-nas">O nás</a>
            <a href="/lide-a-kontakty">Lidé &amp; kontakty</a>
          </nav>
        </div>
      </div>
    </section>
  </main>
  <Paticka />
</Base>

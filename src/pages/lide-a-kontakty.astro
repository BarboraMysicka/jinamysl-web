---
import Base from '../layouts/Base.astro';
import HlavickaPodstranka from '../components/HlavickaPodstranka.astro';
import Paticka from '../components/Paticka.astro';
import { getCollection } from 'astro:content';

const tym = (await getCollection('tym')).sort((a, b) => a.data.poradi - b.data.poradi);
---
<Base title="Lidé & kontakty — Jiná mysl, z. s." popis="Zakladatelky Jiná mysl a kontaktní údaje spolku." zamkniZvenci={true}>
  <HlavickaPodstranka />

  <main class="podstranka">
    <section class="onas-hero">
      <div class="wrap">
        <span class="d-stitek">Lidé &amp; kontakty</span>
        <h1 class="onas-h1">Lidé za Jiná mysl</h1>
        <p class="onas-uvod odhal">Jiná mysl založilo pět lidí. Naše projekty ale vznikají s širším okruhem výzkumníků, designérů, odborníků z konkrétních oblastí i lidí s přímou zkušeností. Tým proto není u každého projektu stejný.</p>
      </div>
    </section>

    <section class="d-sekce">
      <div class="wrap">
        <span class="d-stitek">Zakladatelky</span>
        <div class="lide-mrizka">
          {tym.map((c) => (
            <article class="lide-karta odhal">
              <img src={c.data.foto} alt={c.data.jmeno} loading="lazy" />
              <div>
                <h3>{c.data.jmeno}</h3>
                <p class="lide-role">{c.data.role}</p>
                {c.data.statutar && <p class="lide-statutar">{c.data.statutar}</p>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="d-sekce" id="napiste-nam">
      <div class="wrap">
        <span class="d-stitek">Kontakt</span>
        <h2 class="odhal">Napište nám rovnou tady</h2>
        <p class="onas-uvod odhal">Nabídka spolupráce, dotaz k projektu nebo jen námět — ozveme se, jak nejdřív to půjde.</p>
        <div class="kontakt-blok odhal">
          <form class="kontakt-form" action="https://formsubmit.co/marie.zimmermannova@jinamysl.cz" method="POST">
            <input type="hidden" name="_subject" value="Nová zpráva z webu jinamysl.cz" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_next" value="https://jinamysl.cz/dekujeme/" />
            <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <label class="pole">
              <span>Jméno</span>
              <input type="text" name="jmeno" required autocomplete="name" />
            </label>
            <label class="pole">
              <span>Váš e-mail</span>
              <input type="email" name="email" required autocomplete="email" />
            </label>
            <label class="pole">
              <span>Zpráva</span>
              <textarea name="zprava" rows="5" required></textarea>
            </label>
            <button type="submit" class="btn btn-plny">Odeslat <span class="sipka">→</span></button>
            <p class="kontakt-gdpr">Odesláním souhlasíte se zpracováním uvedených údajů za účelem odpovědi. Doručení zajišťuje služba FormSubmit.</p>
          </form>
          <aside class="kontakt-karta kontakt-udaje">
            <h3>Jiná mysl, z. s.</h3>
            <p class="kontakt-stitek">E-mail</p>
            <button type="button" class="mail-kopie" onclick="zkopirujMail(this)" data-mail="marie.zimmermannova@jinamysl.cz" aria-label="Zkopírovat e-mail marie.zimmermannova@jinamysl.cz">
              <span class="mail-kopie-adresa">marie.zimmermannova@jinamysl.cz</span>
              <span class="mail-kopie-stav">Kliknutím zkopírujete</span>
            </button>
            <p class="kontakt-udaje-org">IČO: 24654159<br />Sídlo: Únanov 431, 671 31 Únanov</p>
            <a class="onas-org-odkaz" href="https://or.justice.cz/ias/ui/rejstrik-$firma?ico=24654159" target="_blank" rel="noopener">Veřejný rejstřík →</a>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <Paticka />
</Base>

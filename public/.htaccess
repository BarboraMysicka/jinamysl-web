# ── Jiná mysl, z. s. — statický web na Apache (Forpsi) ──

# Vlastní (hezká) 404 stránka
ErrorDocument 404 /404.html

# Bezpečnostní hlavičky
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Content-Type-Options "nosniff"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Komprese textových typů (gzip)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

# Cache statických souborů (rychlejší opakované návštěvy)
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|woff2|webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # HTML ať je vždy čerstvé (nová verze se hned projeví)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
